generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Google orqali kirgan foydalanuvchida parol bo'lmaydi
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  clients       Client[]
  projects      Project[]
  proposals     Proposal[]
  resetTokens   PasswordResetToken[]
  subscription  Subscription?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  plan             PlanType  @default(FREE)
  stripeCustomerId String?
  stripeSubId      String?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Client {
  id        String     @id @default(cuid())
  userId    String
  name      String
  email     String
  company   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects  Project[]
  proposals Proposal[]

  @@index([userId])
}

model Proposal {
  id          String         @id @default(cuid())
  userId      String
  clientId    String
  title       String
  description String?
  amount      Decimal        @db.Decimal(12, 2)
  status      ProposalStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project?
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
}

model Project {
  id         String        @id @default(cuid())
  userId     String
  clientId   String
  proposalId String?       @unique
  title      String
  status     ProjectStatus @default(IN_PROGRESS)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  contract   Contract?
  payments   Payment[]
  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposal   Proposal?     @relation(fields: [proposalId], references: [id])
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
}

model Contract {
  id        String    @id @default(cuid())
  projectId String    @unique
  content   String
  signedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String        @id @default(cuid())
  projectId String
  amount    Decimal       @db.Decimal(12, 2)
  dueDate   DateTime
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum PlanType {
  FREE
  PREMIUM
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum ProjectStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  PAUSED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}
