# ---- Ma'lumotlar bazasi (Supabase / PostgreSQL) ----
# Ilova uchun (pooler, tranzaksiya rejimi)
DATABASE_URL="postgresql://user:parol@host:6543/postgres?pgbouncer=true"
# Migratsiyalar uchun (to'g'ridan-to'g'ri ulanish)
DIRECT_URL="postgresql://user:parol@host:5432/postgres"

# ---- NextAuth ----
# Tasodifiy kalit yaratish:  openssl rand -base64 32
NEXTAUTH_SECRET="bu-yerga-tasodifiy-kalit"
NEXTAUTH_URL="http://localhost:3000"

# ---- Stripe (Premium tarif) ----
# Bu qiymatlarsiz ilova ishlaydi, faqat Premium'ga o'tish o'chiq bo'ladi.
# Kalitlar: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Premium obuna narxining ID'si (price_...), Products bo'limidan olinadi
STRIPE_PRICE_ID=""
# `stripe listen` yoki Dashboard > Webhooks bergan sir (whsec_...)
STRIPE_WEBHOOK_SECRET=""

# Checkout'dan qaytish manzili. Ko'rsatilmasa NEXTAUTH_URL ishlatiladi.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Google orqali kirish (ixtiyoriy) ----
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID
# Authorized redirect URI: https://SIZNING-DOMEN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Email (parolni tiklash uchun) ----
# resend.com > API Keys
RESEND_API_KEY=""
# Tasdiqlangan domendagi manzil, masalan: FreelanceHub <no-reply@sizningdomen.uz>
MAIL_FROM=""

# ---- Analitika (ixtiyoriy) ----
NEXT_PUBLIC_GA_ID=""
